{
  "compilerOptions": {
    "target":          "ES2020",
    "module":          "nodenext",
    "moduleResolution": "nodenext",
    "outDir":          "./dist",
    "rootDir":         "./src",
    "declaration":     true,
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}